# 复制此文件为 .env 并填写真实值（.env 不入库）
# 科大 LLM 平台 API 密钥（必填）
LLM_API_KEY=your-llm-api-key

# LLM 模型（可选，默认 deepseek-chat）
LLM_MODEL=deepseek-v4-flash

# Embedding 模型（可选，默认 qwen3-embedding，平台白名单内）
LLM_EMBEDDING_MODEL=qwen3-embedding

# LLM API 地址（可选，默认校内平台）
# LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1

# CAS 回调地址（部署后改为实际域名）
# CAS_SERVICE_URL=http://localhost:8501

# 新 Web 应用运行模式（production 默认只允许 anonymous）
XIAOWO_ENV=development
XIAOWO_AUTH_MODE=anonymous
# Vite 开发服务器通过 /api 代理 FastAPI 时，公开来源必须是浏览器实际来源。
XIAOWO_PUBLIC_ORIGIN=http://localhost:5173
# 构建后由 FastAPI 同源托管 frontend/dist 时改为 http://localhost:8000。

# 演示/管理员（比赛演示时将 AUTH_MODE 改为 demo）
# XIAOWO_AUTH_MODE=demo
# XIAOWO_ADMIN_IDS=PB25111691

# 真实个人缓存加密密钥（CAS 模式必填；使用独立随机密钥）
# XIAOWO_DATA_KEY=
# XIAOWO_SESSION_SECRET=
# XIAOWO_TRUSTED_PROXY_CIDRS=

# 私有 sidecar；默认关闭联网，不会在本机安装或启动
XIAOWO_WEB_SEARCH_ENABLED=false
XIAOWO_SEARXNG_URL=http://127.0.0.1:8080
XIAOWO_CRAWL4AI_URL=http://127.0.0.1:11235
XIAOWO_INGESTION_WORKER_ENABLED=false
# 结构化证据模型默认复用 LLM_MODEL；联网 readiness 会先用公开合成文本探针。
XIAOWO_EVIDENCE_EXTRACTOR_ENABLED=true
# XIAOWO_EVIDENCE_EXTRACTOR_MODEL=deepseek-v4-flash
# XIAOWO_EVIDENCE_EXTRACTOR_PROBE_TIMEOUT_SECONDS=4
# 仅供 deploy/sidecars adapter 使用；通过服务器运行探针后才能改为 true。
XIAOWO_CRAWL4AI_RUNTIME_ATTESTED=false
# XIAOWO_MAX_CONCURRENT_RUNS=30
# XIAOWO_MAX_QUEUED_RUNS=30
# XIAOWO_REVIEW_DB_PATH=F:\path\to\review.db
# XIAOWO_WEB_EVIDENCE_DIR=F:\path\to\web_evidence
# XIAOWO_PUBLISHED_CHROMA_DIR=F:\path\to\knowledge\chroma_db\web_approved
# XIAOWO_PUBLISHED_BM25_DIR=F:\path\to\web_evidence\approved\bm25
# XIAOWO_SIDECAR_ALLOWED_HOSTS=localhost,127.0.0.1,::1,searxng,crawl4ai
# XIAOWO_RUN_EVENT_RETENTION_SECONDS=3600
# XIAOWO_EVENT_WAIT_TIMEOUT_SECONDS=1
# XIAOWO_JOB_DONE_RETENTION_SECONDS=604800
# XIAOWO_JOB_DEAD_RETENTION_SECONDS=7776000
# XIAOWO_ORPHAN_GENERATION_RETENTION_SECONDS=604800
# XIAOWO_REVIEW_CLEANUP_INTERVAL_SECONDS=300

# 校团委 young 平台 token（可选，活动推荐功能）
# YOUNG_TOKEN=

# 联网检索增强（2026-09-01 上线；默认开启，均可回退）
# 长问句改写为 1-2 个关键词查询；联网搜索最多加轮数（1-3）
# XIAOWO_WEB_QUERY_REWRITE=true
# XIAOWO_WEB_SEARCH_ROUNDS=2
# Embedding 模式：auto（默认，API优先）| api 强制 | local 强制（本机 768 维索引直接匹配）
# XIAOWO_EMBEDDING_MODE=auto
# 微信公众号联网通道（科大相关问题优先；受熔断保护）
# XIAOWO_WECHAT_ENABLED=true

# ── 演示重置保护（2026-09-03 加固）──
# 默认 false：/auth/demo/reset 返回 404、前端按钮隐藏。管理员清场时置 true 并配置密钥。
# 开启后调用需请求头 X-Demo-Reset-Key == 本变量；清空前自动导出快照到 data/backups/demo_reset_*/
#XIAOWO_DEMO_RESET_ENABLED=false
#XIAOWO_DEMO_RESET_KEY=change-me-to-a-32-char-secret
