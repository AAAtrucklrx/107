# 复制此文件为 .env 并填写真实值（.env 不入库）
# 科大 LLM 平台 API 密钥（必填）
LLM_API_KEY=your-llm-api-key

# LLM 模型（可选，默认 deepseek-chat）
LLM_MODEL=deepseek-v4-flash

# Embedding 模型（可选，默认 qwen3-embedding，平台白名单内）
LLM_EMBEDDING_MODEL=qwen3-embedding

# LLM API 地址（可选，默认校内平台）
# LLM_BASE_URL=https://api.llm.ustc.edu.cn/v1

# CAS 回调地址（部署后改为实际域名）
# CAS_SERVICE_URL=http://localhost:8501

# 校团委 young 平台 token（可选，活动推荐功能）
# YOUNG_TOKEN=
