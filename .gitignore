# 密钥与敏感配置（不入库）
.env

# 运行态数据库
database/*.db
data/*.db

# 爬虫原始数据（可重建）
scripts/data/

# jw 登录态浏览器 profile（含会话 cookie, 绝不可入库）
scripts/.jw_profile/
scripts/.jw_profile2/

# 向量库持久化目录
knowledge/chroma_db/

# Python 缓存
__pycache__/
*.pyc

# 本地审查/工具产物
.qoder/

# 知识库备份目录
knowledge_backup_*/

# 本地 IDE/工具配置
.claude/

# 调试脚本与截图归档（Phase 0 起，垃圾产物不入库）
scripts/archive/
docs/archive/

# 调试日志
*.log

# 子代理抓取临时产物（可重建，不入库）
_ustc_scrape/
