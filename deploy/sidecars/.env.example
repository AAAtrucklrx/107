# Copy to deploy/sidecars/.env on the server only. Never commit the real file.
CRAWL4AI_API_TOKEN=replace-with-at-least-32-random-bytes
CRAWL4AI_REDIS_PASSWORD=replace-with-an-independent-random-password
SEARXNG_SECRET=replace-with-at-least-32-random-bytes

# Keep the audited Crawl4AI release. A deployment may replace this with the
# registry digest for the same verified v0.9.2 image.
CRAWL4AI_IMAGE=unclecode/crawl4ai:0.9.2
SEARXNG_IMAGE=searxng/searxng:latest

# Leave false until verify_runtime.py passes on this exact server/image.
XIAOWO_CRAWL4AI_RUNTIME_ATTESTED=false
